{
  "skills_dirs": [
    ".claude/skills",
    ".codex/skills"
  ],
  "personal_files": [
    ".claude/CLAUDE.md",
    ".codex/AGENTS.md"
  ],
  "files": [
    {
      "from": "claude/statusline.py",
      "to": ".claude/statusline.py"
    },
    {
      "from": "claude/notify.py",
      "to": ".claude/notify.py"
    },
    {
      "from": "claude/themes/graphite.json",
      "to": ".claude/themes/graphite.json"
    },
    {
      "from": "claude/themes/paper.json",
      "to": ".claude/themes/paper.json"
    },
    {
      "from": "claude/themes/honey.json",
      "to": ".claude/themes/honey.json"
    },
    {
      "from": "claude/themes/vaporwave.json",
      "to": ".claude/themes/vaporwave.json"
    }
  ],
  "settings": [
    {
      "from": "claude/settings.json",
      "to": ".claude/settings.json"
    }
  ],
  "codex_footer": ["model-with-reasoning", "current-dir", "git-branch", "branch-changes", "context-used", "five-hour-limit", "weekly-limit"],
  "terminal_schemes": {
    "from": "terminal/schemes.json",
    "to": [
      "AppData/Local/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json",
      "AppData/Local/Packages/Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe/LocalState/settings.json",
      "AppData/Local/Microsoft/Windows Terminal/settings.json"
    ]
  },
  "env": {
    "SCAFFOLD_PYTHON": {
      "value": "{{PYTHON}}",
      "why": "the Python that ran the workstation setup, for project hooks (python may not be on PATH, or be python3)"
    },
    "DISABLE_TELEMETRY": {
      "value": "true",
      "why": "MCP for Blender (and other tools that honour it) send no usage telemetry"
    },
    "BLENDER": {
      "find": [
        "C:/Program Files/Blender Foundation/Blender */blender.exe",
        "/Applications/Blender.app/Contents/MacOS/Blender",
        "/usr/bin/blender",
        "/snap/bin/blender"
      ],
      "why": "the path of blender.exe for headless runs (modules/blender: \"$BLENDER\" -b ...); the newest install found"
    }
  }
}
